# ---- Google Gemini ----
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Output dimension for gemini-embedding-001 (768 recommended; required for empty FAISS index)
GEMINI_EMBEDDING_DIMENSION=768

# ---- Clerk (JWT verification) ----
# Secret key is optional for verification; JWKS URL is used to validate tokens.
CLERK_SECRET_KEY=
# e.g. https://your-app.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=
# Optional: expected issuer / audience for stricter validation.
CLERK_ISSUER=
CLERK_AUDIENCE=
# Set to true to bypass JWT verification during local development only.
AUTH_DISABLED=false

# ---- CORS / frontend ----
FRONTEND_URL=http://localhost:3000

# ---- Storage ----
FAISS_INDEX_DIR=faiss_index
UPLOAD_DIR=uploads

# ---- RAG tuning ----
TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_UPLOAD_MB=25

# ---- Chat vision (Ragmob) ----
CHAT_IMAGE_MAX_MB=8
CHAT_IMAGE_MAX_DIMENSION=4096
# Sliding TTL for per-conversation image follow-ups (memory + disk mirror).
CHAT_IMAGE_CONTEXT_TTL_SECONDS=3600
# Optional override for disk mirror (default: system temp /ragmob_chat_image_context)
# CHAT_IMAGE_CONTEXT_DIR=
CHAT_HISTORY_LIMIT=20

# ---- App ----
APP_VERSION=1.0.0
LOG_LEVEL=INFO
