# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Clerk (JWT verification) ----
# Secret key is optional for verification; JWKS URL is used to validate tokens.
CLERK_SECRET_KEY=
# e.g. https://your-app.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=
# Optional: expected issuer / audience for stricter validation.
CLERK_ISSUER=
CLERK_AUDIENCE=
# Set to true to bypass JWT verification during local development only.
AUTH_DISABLED=false

# ---- CORS / frontend ----
FRONTEND_URL=http://localhost:3000

# ---- Storage ----
FAISS_INDEX_DIR=faiss_index
UPLOAD_DIR=uploads

# ---- RAG tuning ----
TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_UPLOAD_MB=25

# ---- App ----
APP_VERSION=1.0.0
LOG_LEVEL=INFO
